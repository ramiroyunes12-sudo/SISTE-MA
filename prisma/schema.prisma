// Esquema de la base de datos. Docs: https://pris.ly/d/prisma-schema
//
// Las tablas viven en el esquema "entradas" (no en "public"), así la API
// automática de Supabase no las publica. Los montos van en centavos (Int)
// para no tener errores de redondeo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["entradas"]
}

// ─── Productoras, usuarios del panel y de la puerta ───────────────────────────

enum Rol {
  ADMIN // dueño de la plataforma: ve y maneja todo
  ORGANIZADOR // de una productora: sus eventos y sus números
  VALIDADOR // de una productora: solo la puerta

  @@schema("entradas")
}

// Quien organiza eventos usando la plataforma. Cada evento es de una productora
// y su gente solo ve lo suyo. Desactivarla corta el acceso de toda su gente.
model Productora {
  id            String   @id @default(uuid(7)) @db.Uuid
  nombre        String   @unique
  activa        Boolean  @default(true)
  creadaEn      DateTime @default(now()) @map("creada_en") @db.Timestamptz(3)
  actualizadaEn DateTime @updatedAt @map("actualizada_en") @db.Timestamptz(3)

  // Cobros (paso 11). Transferencia: el alias y a nombre de quién está (se
  // le muestran al comprador). Tienen que ser de la misma cuenta de Mercado
  // Pago conectada: es la que se revisa para ver si entró la plata.
  aliasTransferencia   String?   @map("alias_transferencia")
  titularTransferencia String?   @map("titular_transferencia")
  // Cargo por servicio al pagar con Mercado Pago, en centésimos de por ciento
  // (440 = 4,40%): cubre la comisión que descuenta Mercado Pago.
  recargoMpBps         Int       @default(440) @map("recargo_mp_bps")
  // Cuenta de Mercado Pago conectada: su número de usuario y el Access Token
  // cifrado (ver src/lib/cifrado.ts). Nunca el token tal cual.
  mpUsuarioId          String?   @unique @map("mp_usuario_id") // una cuenta, una sola productora
  mpCuenta             String?   @map("mp_cuenta") // nombre de la cuenta, para mostrar
  mpTokenCifrado       String?   @map("mp_token_cifrado")
  mpConectadaEn        DateTime? @map("mp_conectada_en") @db.Timestamptz(3)
  // Última vez que se miraron los movimientos (para no consultar de más) y
  // hasta cuándo quedaron revisados (la próxima vez se pide solo lo nuevo).
  mpRevisadoEn         DateTime? @map("mp_revisado_en") @db.Timestamptz(3)
  mpRevisadoHasta      DateTime? @map("mp_revisado_hasta") @db.Timestamptz(3)

  usuarios            Usuario[]
  eventos             Evento[]
  montosTransferencia MontoTransferencia[]

  @@map("productoras")
  @@schema("entradas")
}

model Usuario {
  id                    String    @id @default(uuid(7)) @db.Uuid
  nombre                String
  email                 String    @unique // siempre en minúsculas
  hashContrasena        String    @map("hash_contrasena") // scrypt; nunca la contraseña en sí
  rol                   Rol       @default(VALIDADOR)
  // ADMIN no tiene productora; ORGANIZADOR y VALIDADOR, sí (lo controla la base).
  productoraId          String?   @map("productora_id") @db.Uuid
  activo                Boolean   @default(true)
  // Contraseña temporal: al entrar, primero tiene que elegir una propia.
  // Vence a las 72 horas (null = no vence).
  debeCambiarContrasena Boolean   @default(false) @map("debe_cambiar_contrasena")
  temporalVenceEn       DateTime? @map("temporal_vence_en") @db.Timestamptz(3)
  // Contra los que prueban contraseñas: 5 fallas seguidas bloquean 15 minutos.
  intentosFallidos      Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta        DateTime? @map("bloqueado_hasta") @db.Timestamptz(3)
  ultimoIngresoEn       DateTime? @map("ultimo_ingreso_en") @db.Timestamptz(3)
  creadoEn              DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn         DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  productora        Productora? @relation(fields: [productoraId], references: [id], onDelete: Restrict)
  sesiones          Sesion[]
  entradasValidadas Entrada[]   @relation("ValidadaPor")
  cortesiasEmitidas Orden[]     @relation("EmitidaPor")
  pagosRegistrados  Pago[]      @relation("RegistradoPor")
  escaneos          Escaneo[]
  busquedas         Busqueda[]

  @@index([productoraId])
  @@map("usuarios")
  @@schema("entradas")
}

// Una sesión abierta (un navegador con el panel abierto). El navegador guarda
// un código secreto en una cookie; acá solo se guarda su huella (SHA-256),
// así una copia de la base no sirve para entrar.
model Sesion {
  id        String   @id // huella SHA-256 (hex) del código de la cookie
  usuarioId String   @map("usuario_id") @db.Uuid
  creadaEn  DateTime @default(now()) @map("creada_en") @db.Timestamptz(3)
  expiraEn  DateTime @map("expira_en") @db.Timestamptz(3) // se estira con el uso, hasta 30 días

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesiones")
  @@schema("entradas")
}

// ─── Evento, tipos de entrada y lotes ─────────────────────────────────────────

enum EstadoEvento {
  BORRADOR // no se ve en la página pública
  PUBLICADO // a la venta
  FINALIZADO // ya pasó; no se vende más

  @@schema("entradas")
}

model Evento {
  id                String       @id @default(uuid(7)) @db.Uuid
  productoraId      String       @map("productora_id") @db.Uuid
  slug              String       @unique // parte de la dirección: /e/fiesta-primavera
  nombre            String
  descripcion       String?
  fecha             DateTime     @db.Timestamptz(3) // día y hora de inicio
  lugar             String
  direccion         String?
  flyerUrl          String?      @map("flyer_url")
  maxPorCompra      Int          @default(4) @map("max_por_compra") // 1 a 4 (decidido por Ramiro, 10/10/2026)
  cupoCortesias     Int          @default(0) @map("cupo_cortesias")
  cortesiasEmitidas Int          @default(0) @map("cortesias_emitidas")
  estado            EstadoEvento @default(BORRADOR)
  creadoEn          DateTime     @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn     DateTime     @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  productora Productora    @relation(fields: [productoraId], references: [id], onDelete: Restrict)
  tipos      TipoEntrada[]
  ordenes    Orden[]
  entradas   Entrada[]
  escaneos   Escaneo[]
  busquedas  Busqueda[]

  @@index([productoraId])
  @@map("eventos")
  @@schema("entradas")
}

// General, VIP, etc. Cada tipo tiene sus propios lotes.
model TipoEntrada {
  id       String @id @default(uuid(7)) @db.Uuid
  eventoId String @map("evento_id") @db.Uuid
  nombre   String
  orden    Int    @default(0) // orden en que se muestra en la página

  evento   Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  lotes    Lote[]
  entradas Entrada[]

  @@unique([eventoId, nombre])
  @@unique([id, eventoId]) // para las claves compuestas de Entrada
  @@map("tipos_entrada")
  @@schema("entradas")
}

// Lote 1, 2, 3... Se vende el de menor número que tenga lugar.
// disponibles = cupo - vendidas - reservadas (la base no deja que dé negativo).
model Lote {
  id             String @id @default(uuid(7)) @db.Uuid
  tipoEntradaId  String @map("tipo_entrada_id") @db.Uuid
  numero         Int // 1, 2, 3...
  nombre         String // "Lote 1"
  precioCentavos Int    @map("precio_centavos")
  cupo           Int
  vendidas       Int    @default(0) // pagadas
  reservadas     Int    @default(0) // en órdenes pendientes de pago

  tipoEntrada TipoEntrada @relation(fields: [tipoEntradaId], references: [id], onDelete: Cascade)
  entradas    Entrada[]

  @@unique([tipoEntradaId, numero])
  @@unique([id, tipoEntradaId]) // para las claves compuestas de Entrada
  @@map("lotes")
  @@schema("entradas")
}

// ─── Órdenes (compras y cortesías) ────────────────────────────────────────────

enum TipoOrden {
  VENTA
  CORTESIA

  @@schema("entradas")
}

// Cómo se pagó (o eligió pagar) una orden.
enum MetodoPago {
  TRANSFERENCIA // a alias de la productora, con monto único (sin recargo)
  MERCADOPAGO // Checkout Pro (con cargo por servicio)
  MANUAL // lo confirmó a mano alguien del panel

  @@schema("entradas")
}

enum EstadoOrden {
  PENDIENTE // reservada, esperando el pago
  PAGADA // o cortesía emitida: las entradas son válidas
  VENCIDA // no pagó a tiempo: se liberó el lugar
  CANCELADA
  REEMBOLSADA

  @@schema("entradas")
}

// La reserva se crea al tocar "Continuar" (todavía sin email ni datos de las
// personas); la base exige esos datos recién cuando la orden pasa a PAGADA.
model Orden {
  id              String      @id @default(uuid(7)) @db.Uuid
  numero          Int         @unique @default(autoincrement()) // el "N° de orden" que ve la gente
  eventoId        String      @map("evento_id") @db.Uuid
  tipo            TipoOrden   @default(VENTA)
  estado          EstadoOrden @default(PENDIENTE)
  email           String? // a dónde se mandan las entradas (en minúsculas)
  telefono        String?
  totalCentavos   Int         @map("total_centavos")
  venceEn         DateTime?   @map("vence_en") @db.Timestamptz(3) // fin de la reserva (solo ventas)
  pagadaEn        DateTime?   @map("pagada_en") @db.Timestamptz(3)
  reembolsadaEn   DateTime?   @map("reembolsada_en") @db.Timestamptz(3)
  mpPreferenciaId String?     @unique @map("mp_preferencia_id") // Mercado Pago: checkout creado
  metodoPago      MetodoPago? @map("metodo_pago") // el último que eligió quien compra
  recargoCentavos Int         @default(0) @map("recargo_centavos") // cargo por servicio de Mercado Pago
  emitidaPorId    String?     @map("emitida_por_id") @db.Uuid // admin que dio la cortesía

  // El link de la compra (/compra/<llave>) es la llave para verla: acá solo
  // se guarda su huella (SHA-256), como con las sesiones.
  accesoHash    String? @unique @map("acceso_hash")
  // De dónde salió la reserva (huellas SHA-256, para el límite de reservas
  // abiertas): el navegador (cookie) y la conexión (IP).
  compradorHash String? @map("comprador_hash")
  ipHash        String? @map("ip_hash")

  // Mail con las entradas (src/lib/mails/pendientes.ts): falta mandarlo
  // mientras la orden esté PAGADA sin mailEnviadoEn. Cada intento se "toma"
  // con un UPDATE condicionado (mailIntentoEn: cuándo empezó el último), así
  // dos envíos a la vez no lo mandan dos veces; si falló, se reintenta desde
  // mailReintentarDesde.
  mailEnviadoEn       DateTime? @map("mail_enviado_en") @db.Timestamptz(3)
  mailIntentoEn       DateTime? @map("mail_intento_en") @db.Timestamptz(3)
  mailReintentarDesde DateTime? @map("mail_reintentar_desde") @db.Timestamptz(3)
  mailIntentos        Int       @default(0) @map("mail_intentos")
  mailError           String?   @map("mail_error") // por qué falló (sin datos de la persona)
  // "Reenviar mis entradas": máximo 3 por día por orden (paso 16).
  reenviosCount       Int       @default(0) @map("reenvios_count")
  reenviosDesde       DateTime? @map("reenvios_desde") @db.Timestamptz(3)

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  evento     Evento    @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  emitidaPor Usuario?  @relation("EmitidaPor", fields: [emitidaPorId], references: [id], onDelete: SetNull)
  entradas   Entrada[]
  pagos      Pago[]

  montoTransferencia MontoTransferencia?

  @@unique([id, eventoId]) // para que cada entrada quede atada al evento de su orden
  @@index([eventoId, estado])
  @@index([email])
  @@index([estado, venceEn]) // para liberar reservas vencidas
  @@index([estado, mailEnviadoEn]) // para reintentar mails que fallaron
  @@index([compradorHash, estado]) // reservas abiertas por navegador
  @@index([ipHash, estado]) // y por conexión
  @@map("ordenes")
  @@schema("entradas")
}

// El monto exacto (con centavos únicos) que tiene que transferir una orden.
// Como la transferencia no dice quién la mandó, el monto es lo que la ata a la
// orden: no se puede repetir dentro de la misma productora (misma cuenta).
// Se borra recién 48 horas después de que la orden deja de estar pendiente,
// por si la plata llega tarde.
model MontoTransferencia {
  ordenId       String   @id @map("orden_id") @db.Uuid
  productoraId  String   @map("productora_id") @db.Uuid
  montoCentavos Int      @map("monto_centavos")
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  orden      Orden      @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  productora Productora @relation(fields: [productoraId], references: [id], onDelete: Restrict)

  @@unique([productoraId, montoCentavos])
  @@map("montos_transferencia")
  @@schema("entradas")
}

// Cada pago recibido para una orden. Una orden puede tener más de uno (por
// ejemplo, si alguien paga dos veces): los que no dieron entradas quedan
// marcados para devolver.
model Pago {
  id                  String     @id @default(uuid(7)) @db.Uuid
  ordenId             String     @map("orden_id") @db.Uuid
  // Número del pago en Mercado Pago (evita procesar dos veces el mismo pago).
  // Los confirmados a mano llevan "manual:<id de la orden>".
  mpPagoId            String     @unique @map("mp_pago_id")
  metodo              MetodoPago @default(MERCADOPAGO)
  estadoMp            String     @map("estado_mp") // approved, refunded, etc. (como lo manda Mercado Pago)
  montoCentavos       Int        @map("monto_centavos")
  comisionCentavos    Int        @default(0) @map("comision_centavos") // lo que descontó Mercado Pago
  reembolsadoCentavos Int        @default(0) @map("reembolsado_centavos")
  // No dio entradas (la orden ya estaba paga, o llegó tarde y no había
  // lugar): hay que devolver la plata. `nota` dice por qué.
  aDevolver           Boolean    @default(false) @map("a_devolver")
  nota                String?
  registradoPorId     String?    @map("registrado_por_id") @db.Uuid // quién lo confirmó a mano
  creadoEn            DateTime   @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn       DateTime   @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  orden         Orden    @relation(fields: [ordenId], references: [id], onDelete: Restrict)
  registradoPor Usuario? @relation("RegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([ordenId])
  @@index([aDevolver])
  @@map("pagos")
  @@schema("entradas")
}

// ─── Entradas (una por persona, con su QR) ───────────────────────────────────

enum EstadoEntrada {
  PENDIENTE // la orden todavía no se pagó: el QR no sirve
  VALIDA
  USADA // ya entró
  ANULADA

  @@schema("entradas")
}

model Entrada {
  id             String        @id @default(uuid(7)) @db.Uuid
  ordenId        String        @map("orden_id") @db.Uuid
  eventoId       String        @map("evento_id") @db.Uuid
  tipoEntradaId  String        @map("tipo_entrada_id") @db.Uuid
  loteId         String?       @map("lote_id") @db.Uuid // vacío en las cortesías
  titular        String? // nombre y apellido (obligatorio desde que la orden se paga)
  dni            String? // solo números (obligatorio desde que la orden se paga)
  codigo         String        @unique // 128 bits al azar (hex); el QR lleva este código firmado (src/lib/entradas/codigo.ts)
  precioCentavos Int           @map("precio_centavos") // lo que se pagó por esta entrada
  estado         EstadoEntrada @default(PENDIENTE)
  usadaEn        DateTime?     @map("usada_en") @db.Timestamptz(3)
  validadaPorId  String?       @map("validada_por_id") @db.Uuid
  creadoEn       DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime      @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  // Claves compuestas: la orden y el tipo tienen que ser del mismo evento que
  // la entrada, y el lote del mismo tipo. Así una entrada no puede mezclar eventos.
  orden       Orden       @relation(fields: [ordenId, eventoId], references: [id, eventoId], onDelete: Cascade)
  evento      Evento      @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  tipoEntrada TipoEntrada @relation(fields: [tipoEntradaId, eventoId], references: [id, eventoId], onDelete: Restrict)
  lote        Lote?       @relation(fields: [loteId, tipoEntradaId], references: [id, tipoEntradaId], onDelete: Restrict)
  validadaPor Usuario?    @relation("ValidadaPor", fields: [validadaPorId], references: [id], onDelete: SetNull)
  escaneos    Escaneo[]

  @@index([eventoId, dni]) // búsqueda por DNI en la puerta
  @@index([eventoId, estado]) // contador de ingresados
  @@index([ordenId])
  @@map("entradas")
  @@schema("entradas")
}

// ─── Registro de cada escaneo en la puerta ───────────────────────────────────

enum MetodoIngreso {
  QR
  DNI // búsqueda manual

  @@schema("entradas")
}

// ─── Búsquedas en la puerta (por DNI o nombre) ───────────────────────────────

// Quién buscó qué y cuándo (pedido por Ramiro, 10/10/2026), y el tope de
// búsquedas por minuto de cada validador (src/lib/entradas/buscar.ts).
model Busqueda {
  id        String   @id @default(uuid(7)) @db.Uuid
  eventoId  String   @map("evento_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid // quién buscó
  texto     String // lo que escribió: un DNI o un nombre (dato personal)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId, creadoEn]) // el tope por minuto
  @@index([eventoId, creadoEn])
  @@map("busquedas")
  @@schema("entradas")
}

enum ResultadoEscaneo {
  PASA
  YA_INGRESO
  NO_VALIDA

  @@schema("entradas")
}

model Escaneo {
  id          String           @id @default(uuid(7)) @db.Uuid
  eventoId    String           @map("evento_id") @db.Uuid
  entradaId   String?          @map("entrada_id") @db.Uuid // vacío si el QR no corresponde a ninguna entrada
  usuarioId   String           @map("usuario_id") @db.Uuid // quién escaneó
  metodo      MetodoIngreso
  resultado   ResultadoEscaneo
  codigoLeido String?          @map("codigo_leido") // lo que leyó la cámara (para investigar QR truchos)
  creadoEn    DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)

  evento  Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  entrada Entrada? @relation(fields: [entradaId], references: [id], onDelete: SetNull)
  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([eventoId, creadoEn])
  @@index([entradaId])
  @@map("escaneos")
  @@schema("entradas")
}
