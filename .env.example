# Copiá este archivo como .env y completá los valores.
# El .env NUNCA se sube a GitHub (tiene contraseñas).

# Conexión que usa el sistema: Supabase → botón "Connect" → Transaction pooler (puerto 6543).
DATABASE_URL="postgresql://USUARIO.TU_PROYECTO:TU_CONTRASEÑA@aws-0-TU_REGION.pooler.supabase.com:6543/postgres"

# Conexión para crear y modificar tablas: Supabase → "Connect" → Session pooler (puerto 5432).
# (El esquema "entradas" y el cifrado los agrega solo prisma.config.ts.)
DIRECT_URL="postgresql://USUARIO.TU_PROYECTO:TU_CONTRASEÑA@aws-0-TU_REGION.pooler.supabase.com:5432/postgres"

# Opcional: certificado del servidor de la base. Con Supabase no hace falta
# (el sistema ya trae el de Supabase). Solo para otra base o si Supabase lo renueva.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"


# Clave para cifrar datos secretos que se guardan en la base (el Access Token
# de Mercado Pago de cada productora). Al menos 32 caracteres al azar, por
# ejemplo la salida de: openssl rand -base64 32
# Si se pierde o se cambia, hay que volver a conectar las cuentas de Mercado Pago.
# CLAVE_CIFRADO=""

# Clave para firmar el código de cada entrada (el del QR). Otra distinta de
# CLAVE_CIFRADO, también de al menos 32 caracteres al azar (panel → Claves).
# Si se cambia, ningún QR ya emitido sirve más.
# CLAVE_CODIGOS=""

# Opcional: la dirección pública del sistema (a dónde vuelve y avisa Mercado
# Pago). En Vercel no hace falta: se usa la de producción.
# URL_PUBLICA="https://siste-ma.vercel.app"

# Mail con las entradas (Gmail): la cuenta de la plataforma y una
# "contraseña de aplicación" de esa cuenta (myaccount.google.com/apppasswords,
# necesita la verificación en 2 pasos). Sin estas variables no sale ningún mail.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PUERTO="465"
# SMTP_USUARIO="cuenta@gmail.com"
# SMTP_CLAVE=""
# Opcional: la dirección del remitente si no es la cuenta (con otro servicio).
# MAIL_DESDE=""

# La clave con la que Vercel llama a la tarea diaria que manda los mails que
# quedaron pendientes (/api/mails/pendientes). 16+ caracteres al azar (panel →
# Claves). Sin ella, la tarea no hace nada.
# CRON_SECRET=""
