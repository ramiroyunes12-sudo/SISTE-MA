# Copiá este archivo como .env y completá los valores.
# El .env NUNCA se sube a GitHub (tiene contraseñas).

# Conexión que usa el sistema: Supabase → botón "Connect" → Transaction pooler (puerto 6543).
DATABASE_URL="postgresql://USUARIO.TU_PROYECTO:TU_CONTRASEÑA@aws-0-TU_REGION.pooler.supabase.com:6543/postgres"

# Conexión para crear y modificar tablas: Supabase → "Connect" → Session pooler (puerto 5432).
DIRECT_URL="postgresql://USUARIO.TU_PROYECTO:TU_CONTRASEÑA@aws-0-TU_REGION.pooler.supabase.com:5432/postgres"

# Opcional: certificado del servidor de la base. Con Supabase no hace falta
# (el sistema ya trae el de Supabase). Solo para otra base o si Supabase lo renueva.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"
