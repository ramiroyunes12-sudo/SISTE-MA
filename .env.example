# Copiá este archivo como .env y completá los valores.
# El .env NUNCA se sube a GitHub (tiene contraseñas).

# Conexión que usa el sistema: Supabase → botón "Connect" → Transaction pooler (puerto 6543).
DATABASE_URL="postgresql://postgres.TU_PROYECTO:TU_CONTRASEÑA@aws-0-TU_REGION.pooler.supabase.com:6543/postgres"

# Conexión para crear y modificar tablas: Supabase → "Connect" → Session pooler (puerto 5432).
DIRECT_URL="postgresql://postgres.TU_PROYECTO:TU_CONTRASEÑA@aws-0-TU_REGION.pooler.supabase.com:5432/postgres"

# Certificado de Supabase para verificar que la conexión es segura.
# Supabase → Database → Settings → SSL Configuration → "Download certificate".
# Abrí el archivo con el Bloc de notas y pegá TODO el contenido entre las comillas.
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
PEGÁ ACÁ EL CONTENIDO DEL CERTIFICADO
-----END CERTIFICATE-----"
